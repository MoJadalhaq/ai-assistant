{
  // The Worker: code that runs on Cloudflare, plus its tests (which run in the same runtime).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    // worker-configuration.d.ts is generated by `npm run cf-typegen` from wrangler.jsonc.
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["worker", "shared", "test"]
}
