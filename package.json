{
  "name": "ai-receptionist",
  "private": true,
  "version": "0.1.0",
  "description": "Demo: a bilingual (Saudi Arabic and English) AI receptionist for a fictional hotel in Jeddah.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run cf-typegen && tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed-local.ts",
    "tool": "node scripts/try-tool.ts",
    "chat": "node --env-file=.dev.vars scripts/chat-cli.ts",
    "eval": "node --env-file=.dev.vars evals/run.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
