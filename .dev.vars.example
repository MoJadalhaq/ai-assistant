# Local secrets and settings for `npm run dev`.
# Copy this file to `.dev.vars` and fill it in. `.dev.vars` is git-ignored: never commit it.
# In production the same names are set with `npx wrangler secret put <NAME>`.

# Gemini API key from Google AI Studio (https://aistudio.google.com). Server-side only.
GEMINI_API_KEY=

# Which Gemini model the assistant uses.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: webhook that receives every handoff ticket (n8n or similar). Leave empty to turn it off.
# Payload: docs/handoff-webhook.md
N8N_WEBHOOK_URL=
