/**
 * Cloudflare Worker configuration.
 * One Worker serves both the built React app (static assets) and the /api routes.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-receptionist",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-10",
	// Custom domain: Cloudflare creates the DNS record and HTTPS certificate on deploy.
	"routes": [{ "pattern": "reception.jadalhaq.com", "custom_domain": true }],
	// The *.workers.dev address is off, so the demo is only served from the custom domain.
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		// Unknown paths such as /staff get index.html, so the React app can handle its own pages.
		"not_found_handling": "single-page-application",
		// Without this, opening an /api URL in a browser tab counts as page navigation
		// and would get index.html instead of reaching the Worker.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ai-receptionist-db",
			// Placeholder: local development ignores it. Replaced with the real id
			// when the database is created on Cloudflare in Phase 3.
			"database_id": "9cd13983-4dec-4a6b-af56-74ba9ead910f",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Not a secret, so it lives here. `.dev.vars` can override it locally.
		"GEMINI_MODEL": "gemini-3.5-flash-lite",
		// MINIMAL, LOW, MEDIUM or HIGH. Empty means the model's default.
		"GEMINI_THINKING_LEVEL": "",
		// Daily budget (docs/PLAN.md, decision 10). A guest message costs about 2 to 3 model calls,
		// so 150 messages is roughly 400 calls. Keep it under the free-tier requests-per-day
		// shown in AI Studio, minus what the evals use (they share the same key).
		"DAILY_MESSAGES_PER_VISITOR": 30,
		"DAILY_MESSAGES_TOTAL": 150
	},
	// GEMINI_API_KEY is a secret: `.dev.vars` locally, `npx wrangler secret put GEMINI_API_KEY` in production.
	"ratelimits": [
		{
			// Burst limit for /api/chat: 6 messages per minute per visitor, counted per Cloudflare location.
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "4101",
			"simple": { "limit": 6, "period": 60 }
		}
	],
	// Daily demo reset at 00:00 UTC (03:00 in Riyadh). Cron Triggers always run on UTC.
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
