# Security headers for the pages and files Cloudflare serves from the static assets.
# (API responses get theirs from Hono's secureHeaders middleware in worker/index.ts.)
#
# The Content-Security-Policy only allows this site's own scripts and data, plus the Google Fonts
# stylesheet and font files. Nothing else can be loaded or embedded, which limits what an
# injected script could do. The page can't be framed by other sites (clickjacking).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
